[Unit]
Description=QS Camera Effects
After=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/share/quickshell/camera-effects/venv/bin/python %h/.config/quickshell/scripts/camera-effects.py daemon
Restart=on-failure
RestartSec=1
Nice=10
CPUWeight=20
IOSchedulingClass=idle

[Install]
WantedBy=default.target
