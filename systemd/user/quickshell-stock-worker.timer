[Unit]
Description=Run Quickshell Stock Safety Worker Every Minute

[Timer]
# OnStartupSec is relative to the user service manager, so the first run
# still fires after a re-login (OnBootSec alone never triggers once the
# machine has been up longer than 45s, leaving OnUnitActiveSec unarmed).
OnStartupSec=45s
OnBootSec=45s
OnUnitActiveSec=60s
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=quickshell-stock-worker.service

[Install]
WantedBy=timers.target
