[Unit]
Description=Quickshell Stock Forecast, Alert and Quant Observer
After=graphical-session.target
ConditionPathExists=%h/.config/quickshell/scripts/stock-service.py

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.config/quickshell/scripts/stock-service.py background run
TimeoutStartSec=120
UMask=0077
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryMax=512M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=-%h/.local/state/quickshell-stock-widget
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
