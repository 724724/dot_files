[Unit]
Description=Secure Quickshell session lock
Documentation=https://quickshell.org/docs/v0.3.0/types/Quickshell.Wayland/WlSessionLock/
PartOf=hyprland-session.target
After=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=30s
StartLimitBurst=20

[Service]
Type=exec
RuntimeDirectory=quickshell-lock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
Environment=QS_DISABLE_FILE_WATCHER=1
Environment=QS_DISABLE_CRASH_HANDLER=1
Environment=QS_LOCK_MODE=1
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_IM_MODULE=compose
Environment=QT_IM_MODULES=compose
ExecStartPre=-%h/.config/quickshell/scripts/quickshell-lock-capture.sh %t/quickshell-lock
ExecStartPre=%h/.config/quickshell/scripts/quickshell-lock-stage.sh %t/quickshell-lock
ExecStart=/usr/bin/qs --no-duplicate --path %t/quickshell-lock/config/shell.qml
ExecStartPost=-%h/.config/quickshell/scripts/quickshell-lock-blur.sh %t/quickshell-lock
# Authenticated unlock exits 10. Restart every other termination, including an
# unexpected SIGTERM or Quickshell's global `qs kill` clean exit.
Restart=always
SuccessExitStatus=10
RestartPreventExitStatus=10
RestartSec=250ms
TimeoutStopSec=5s
KillMode=control-group
LimitCORE=0
UMask=0077
