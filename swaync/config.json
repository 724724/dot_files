{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "cssPriority": "user",

  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 10,
  "control-center-layer": "top",
  "control-center-exclusive-zone": true,

  "notification-2fa-action": true,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "notification-window-width": 500,
  "notification-window-height": -1,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "Nothing",
  "fit-to-screen": true,
  "relative-timestamps": true,

  "control-center-width": 500,

  "widgets": [
    "title",
    "menubar",
    "backlight",
    "volume",
    "mpris",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear"
    },

    "mpris": {
      "autohide": true,
      "show-album-art": true,
      "loop-carousel": false
    },

    "menubar": {
      "buttons#buttons-grid": {
        "label": "",
        "position": "left",
        "actions": [
          {
            "label": "󰀝",
            "type": "toggle",
            "command": "~/.config/swaync/scripts/toggle-airplane.sh",
            "update-command": "~/.config/swaync/scripts/state-airplane.sh"
          },
          {
            "label": "󰖩",
            "type": "toggle",
            "command": "~/.config/swaync/scripts/toggle-wifi.sh",
            "update-command": "~/.config/swaync/scripts/state-wifi.sh"
          },
          {
            "label": "󰂯",
            "type": "toggle",
            "command": "~/.config/swaync/scripts/toggle-bluetooth.sh",
            "update-command": "~/.config/swaync/scripts/state-bluetooth.sh"
          },
          {
            "label": "",
            "type": "toggle",
            "command": "~/.config/swaync/scripts/toggle-dnd.sh",
            "update-command": "~/.config/swaync/scripts/state-dnd.sh"
          },
          {
            "label": "",
            "type": "toggle",
            "command": "~/.config/swaync/scripts/toggle-theme.sh",
            "update-command": "~/.config/swaync/scripts/state-theme.sh"
          }
        ]
      },
      "menu#powermode-buttons": {
        "label": "",
        "actions": [
          {
            "label": "Performance",
            "command": "sudo tlp performance && notify-send Power Performance"
          },
          {
            "label": "Balanced",
            "command": "sudo tlp balanced && notify-send Power Balanced"
          },
          {
            "label": "Power-saver",
            "command": "sudo tlp power-saver && notify-send Power Power-saver"
          }
        ]
      },
      "menu#power-buttons": {
        "label": "",
        "actions": [
          {
            "label": "Lock",
            "command": "hyprlock"
          },
	  {
	    "label": "Logout",
	    "command": "~/.config/swaync/scripts/power.sh logout"
	  },
          {
            "label": "Hibernate",
            "command": "~/.config/swaync/scripts/power.sh hibernate"
          },
          {
            "label": "Shutdown",
            "command": "~/.config/swaync/scripts/power.sh shutdown"
          },
          {
            "label": "Reboot",
            "command": "~/.config/swaync/scripts/power.sh reboot"
          }
        ]
      }
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },

    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "min": 0
    }

  },

  "notification-visibility": {
    "swaync-system": {
      "state": "transient",
      "app-name": "swaync-system"
    }
  }

}
