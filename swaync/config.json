{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,

  "notification-2fa-action": true,
  "notification-inline-replies": false,

  "notification-icon-size": 48,
  "notification-body-image-height": 140,
  "notification-body-image-width": 260,

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,

  "fit-to-screen": true,
  "relative-timestamps": true,

  "control-center-width": 420,
  "control-center-height": 560,
  "notification-window-width": 500,
  "notification-window-height": -1,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "title",
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },

    "mpris": {
      "image-size": 64,
      "image-radius": 3
    },

    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "min": 0
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },

    "buttons-grid": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "󰀝",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-airplane.sh",
          "update-command": "~/.config/swaync/scripts/state-airplane.sh"
        },
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-wifi.sh",
          "update-command": "~/.config/swaync/scripts/state-wifi.sh"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-bluetooth.sh",
          "update-command": "~/.config/swaync/scripts/state-bluetooth.sh"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-lowpower.sh",
          "update-command": "~/.config/swaync/scripts/state-lowpower.sh"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-dnd.sh",
          "update-command": "~/.config/swaync/scripts/state-dnd.sh"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle-theme.sh",
          "update-command": "~/.config/swaync/scripts/state-theme.sh"
        }
      ]
    }
  }
}

