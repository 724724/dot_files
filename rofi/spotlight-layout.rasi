/*******************************************************************************
 * ROFI Shared Layout (North + Offset)
 *******************************************************************************/

configuration {
    modi:                       "drun,calc";
    show-icons:                 true;

    /* 모드 이름 = prompt 아이콘+텍스트 역할 (entry placeholder 제거했으므로) */
    display-drun:               "";
    display-calc:               "󰃬";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";

    kb-mode-next:               "Tab";
    kb-mode-previous:           "ISO_Left_Tab";
    kb-element-next:            "";
    kb-element-prev:            "";

    font:                       "SF Pro Display 10, JetBrainsMono Nerd Font 10"; 
}

window {
    transparency:               "real";
    location:                   north;
    anchor:                     north;
    y-offset:                   30%;
    x-offset:                   0px;
    fullscreen:                 false;
    width:                      800px;
    enabled:                    true;
    border-radius:              20px;
    border:                     1px;
    cursor:                     "default";
    background-color:           @background-col;
    border-color:               @border-col;
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    12px;
    background-color:           transparent;
    text-color:                 @foreground-col;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 inherit;
    font:                       "JetBrainsMono Nerd Font 20"; 
    padding:                    0px 10px 0px 5px;
    vertical-align:             0.5;
}

entry {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          inherit;
    vertical-align:             0.5;
    font:                       "SF Pro Display 10";
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    5px;
    margin:                     0px;
    padding:                    10px;
    background-color:           transparent;
    border:                     1px solid 0px 0px ;
    border-color:               @border-col;
}

element {
    enabled:                    true;
    spacing:                    15px;
    margin:                     0px;
    padding:                    10px;
    border:                     0px;
    border-radius:              12px;
    background-color:           transparent;
    text-color:                 @foreground-col;
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           inherit;
    text-color:                 @foreground-col;
}

element selected.normal {
    background-color:           @selected-col;
    text-color:                 @selected-text-col;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "SF Pro Display 10";
}

message {
    background-color:           transparent;
    text-color:                 @foreground-col;
}

textbox {
    padding:                    12px;
    background-color:           @background-col;
    text-color:                 @foreground-col;
    vertical-align:             0.5;
}

error-message {
    padding:                    12px;
    background-color:           @background-col;
    text-color:                 @foreground-col;
}

drun {
    DBusActivatable: false;
}

