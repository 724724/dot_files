/* ~/.config/rofi/spotlight-dark.rasi */
* {
    background-col:     #101015B3;      /* 어두운 반투명 배경 */
    border-col:         #ffffff20;      /* 옅은 흰색 테두리 */
    
    /* [수정됨] 글씨 색상을 완전한 흰색으로 변경 */
    foreground-col:     #FFFFFF;        
    
    selected-col:       #ffffff15;      /* 선택된 항목 배경 (흰색 투명) */
    selected-text-col:  #FFFFFF;        /* 선택된 항목 글씨 (흰색) */
}
@import "spotlight-layout"
