* {
    background-col:     #ffffffA6;      /* 밝은 반투명 배경 (Glass White) */
    border-col:         #00000020;      /* 검은색 옅은 테두리 */
    foreground-col:     #333333;        /* 어두운 회색 텍스트 */
    selected-col:       #007AFF;        /* macOS Blue Accent */
    selected-text-col:  #ffffff;        /* 선택 시 텍스트는 흰색으로 반전 */
}
@import "spotlight-layout"
