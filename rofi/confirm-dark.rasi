configuration {
    show-icons:                 false;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    background-col:             #101015B3;
    border-col:                 #ffffff20;
    foreground-col:             #FFFFFF;
}

window {
    transparency:               "real";
    location:                   north;
    anchor:                     north;
    y-offset:                   25%;
    x-offset:                   0px;
    width:                      400px;
    border-radius:              20px;
    border:                     1px;
    background-color:           @background-col;
    border-color:               @border-col;
}

mainbox {
    background-color:           transparent;
    children:                   [ "message", "listview" ];
}

message {
    padding:                    20px;
    background-color:           transparent;
}

textbox {
    horizontal-align:           0.5;
    background-color:           transparent;
    text-color:                 @foreground-col;
    font:                       "SF Pro Display 12";
}

listview {
    columns:                    2;
    lines:                      1;
    spacing:                    10px;
    padding:                    10px 20px 20px 20px;
    border:                     0px;
    background-color:           transparent;
}

element {
    padding:                    12px;
    border-radius:              12px;
    cursor:                     pointer;
}

element-text {
    font:                       "SF Pro Display Bold 14";
    background-color:           transparent;
    text-color:                 #ffffff;
    expand:                     true;
    horizontal-align:           0.5;
    vertical-align:             0.5;
}

/* Cancel 버튼 - 파란색 */
element.normal.normal,
element.alternate.normal {
    background-color:           #007AFF;
}

/* 액션 버튼 - 빨간색 */
element.normal.active,
element.alternate.active {
    background-color:           #FF3B30;
}

/* 호버 상태 - Cancel (밝아짐) */
element.selected.normal {
    background-color:           #3395FF;
}

/* 호버 상태 - 액션 (밝아짐) */
element.selected.active {
    background-color:           #FF6961;
}
