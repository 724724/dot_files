#!/usr/bin/env python3
"""
Listen for XF86MonBrightnessUp/Down keys and adjust the backlight while the
SDDM greeter is the foreground process.

When Hyprland is running, brightness-osd.sh already handles these keys, so
this daemon checks for sddm-greeter via pgrep before acting — avoiding any
double-fire conflict.
"""
import os
import select
import subprocess
import sys

import evdev
from evdev import ecodes

STATE_FILE = "/home/sejunlee/.local/state/brightness"
STEP_PCT = 5
BL_DIR = "/sys/class/backlight/intel_backlight"


def find_devices():
    devs = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except (PermissionError, OSError):
            continue
        caps = d.capabilities().get(ecodes.EV_KEY, [])
        if ecodes.KEY_BRIGHTNESSUP in caps or ecodes.KEY_BRIGHTNESSDOWN in caps:
            devs.append(d)
    return devs


GREETER_NAMES = ("sddm-greeter", "sddm-greeter-qt6")


def greeter_running() -> bool:
    # SDDM ships two greeter binaries (Qt5 and Qt6) — match either, since the
    # one in use depends on the build / configured theme.
    for name in GREETER_NAMES:
        if subprocess.run(
            ["/usr/bin/pgrep", "-x", name],
            stdout=subprocess.DEVNULL,
        ).returncode == 0:
            return True
    return False


def read_max() -> int:
    with open(f"{BL_DIR}/max_brightness") as f:
        return int(f.read().strip())


def read_cur() -> int:
    with open(f"{BL_DIR}/brightness") as f:
        return int(f.read().strip())


def write_brightness(value: int) -> None:
    with open(f"{BL_DIR}/brightness", "w") as f:
        f.write(str(value))


def save_state(pct: int) -> None:
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        f.write(f"{pct}\n")
    os.chmod(STATE_FILE, 0o644)


def adjust(delta_pct: int) -> None:
    max_v = read_max()
    cur = read_cur()
    cur_pct = round(cur * 100 / max_v)
    new_pct = max(1, min(100, cur_pct + delta_pct))
    new_val = max(1, round(max_v * new_pct / 100))
    write_brightness(new_val)
    save_state(new_pct)


def main() -> int:
    devs = find_devices()
    if not devs:
        print("sddm-brightness-keys: no brightness-capable input devices", file=sys.stderr)
        return 1
    print(
        "sddm-brightness-keys: watching "
        + ", ".join(f"{d.path} ({d.name})" for d in devs),
        file=sys.stderr,
        flush=True,
    )

    fd_map = {d.fd: d for d in devs}
    while True:
        r, _, _ = select.select(fd_map, [], [])
        for fd in r:
            for ev in fd_map[fd].read():
                if ev.type != ecodes.EV_KEY or ev.value != 1:
                    continue
                if ev.code not in (ecodes.KEY_BRIGHTNESSUP, ecodes.KEY_BRIGHTNESSDOWN):
                    continue
                if not greeter_running():
                    continue
                if ev.code == ecodes.KEY_BRIGHTNESSUP:
                    adjust(+STEP_PCT)
                    print("sddm-brightness-keys: +5%", file=sys.stderr, flush=True)
                else:
                    adjust(-STEP_PCT)
                    print("sddm-brightness-keys: -5%", file=sys.stderr, flush=True)


if __name__ == "__main__":
    sys.exit(main() or 0)
