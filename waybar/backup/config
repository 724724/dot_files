{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 16,
  "margin-right": 16,

  "modules-left": ["clock", "hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["custom/magic", "tray", "pulseaudio", "battery", "network", "custom/swaync"],

  "clock": {
    "format": "󰥔 {:%H:%M:%S  %a %d %b}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'>{}</span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": false,
    "sort-by-number": true
  },

  "custom/magic": {
    "interval": 1,
    "return-type": "json",
    "exec": "hyprctl clients -j | jq -e \".[] | select(.workspace.name == \\\"special:magic\\\")\" > /dev/null && echo '{\"text\":\"󰘔\", \"class\":\"active\"}' || echo '{\"text\":\"\"}'",
    "on-click": "hyprctl dispatch togglespecialworkspace magic",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Connected",
    "format-disconnected": "󰤭 Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n󰈀 {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },

  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#ff6b9d'><sup></sup></span>󰂚",
      "none": "󰂚",
      "dnd-notification": "<span foreground='#ff6b9d'><sup></sup></span>󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "<span foreground='#ff6b9d'><sup></sup></span>󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "<span foreground='#ff6b9d'><sup></sup></span>󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}